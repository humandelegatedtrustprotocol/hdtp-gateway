#!/usr/bin/env bash
# Pre-commit: Go arrives gofmt-styled and Rust rustfmt-styled, or it does not arrive.
#
# Style is applied BEFORE the commit and automatically, never "fixed for style" afterwards:
# every staged *.go file is run through gofmt, and every staged *.rs file (the limits sidecar,
# cmd/pact-limitd, under its rustfmt.toml) through rustfmt, and re-staged, so the commit carries
# the styled text and `make check`'s fmt and limitd-check steps (run again by the pre-push hook)
# have nothing to find.
#
# A file that is only PARTLY staged is refused rather than formatted: re-staging it would sweep
# the unstaged half into the commit behind the author's back.
set -euo pipefail

top="$(git rev-parse --show-toplevel)"
cd "$top"

staged=()
while IFS= read -r f; do
  case "$f" in *.go|*.rs) staged+=("$f") ;; esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#staged[@]}" -gt 0 ] || exit 0

partly=()
for f in "${staged[@]}"; do
  git diff --quiet -- "$f" || partly+=("$f")
done
if [ "${#partly[@]}" -gt 0 ]; then
  echo "pre-commit: these files are only partly staged, so they cannot be styled and re-staged" >&2
  echo "            without committing the rest of them too. Stage them whole, or stash the rest:" >&2
  printf '              %s\n' "${partly[@]}" >&2
  exit 1
fi

restyled=()
for f in "${staged[@]}"; do
  case "$f" in
    *.rs)
      # rustfmt reads the rustfmt.toml beside the crate, found from the file's own directory.
      if ! out="$(cd "$(dirname "$f")" && rustfmt --edition 2021 --emit stdout --quiet < "$(basename "$f")")"; then
        echo "pre-commit: rustfmt could not parse $f — fix the syntax, then commit" >&2
        exit 1
      fi ;;
    *)
      if ! out="$(gofmt < "$f")"; then
        echo "pre-commit: gofmt could not parse $f — fix the syntax, then commit" >&2
        exit 1
      fi ;;
  esac
  if [ "$out" != "$(cat -- "$f")" ]; then
    printf '%s\n' "$out" > "$f"
    restyled+=("$f")
  fi
done
if [ "${#restyled[@]}" -gt 0 ]; then
  git add -- "${restyled[@]}"
  echo "pre-commit: styled and re-staged ${#restyled[@]} file(s):"
  printf '              %s\n' "${restyled[@]}"
fi
