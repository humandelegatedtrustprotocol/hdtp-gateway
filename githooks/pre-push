#!/usr/bin/env bash
# Pre-push: the node's whole gate, run here because nothing else runs it.
#
# This repository has no CI. The node depends on the private module
# github.com/pact-cloud/pact-identity/go, fetched over SSH, and no CI runner is given a key
# (the owner's decision: "No CI key required, we deploy from local only"). So every check that
# used to run on a runner runs on this machine, before anything leaves it:
#
#   make check        fmt, vet, the dependents (the harness, and the cloud's battery when it is on
#                     disk), race tests — with HDTP_TEST_POSTGRES_DSN pointing at a Postgres this
#                     hook starts, so the Postgres engine's tests run rather than skip — and the
#                     portal's page scripts under node --test (make test-js)
#   make analyze      govulncheck, staticcheck, gosec, deadcode against docs/conformance.md
#   make sqlc-check   the committed generated store code matches its sources
#   make fuzz         every Fuzz target under -fuzz, 30 s each
#   make harness      the scenario harness's hermetic tier (no Docker)
#   make scale        last: the store's benchmarks and the import's growth, best of three rounds
#   make web          and web/dist must be unchanged by it — only when the push touches web/
#
# The LIVE harness tiers need Docker and Chrome, so they are opt-in. Each builds what it
# promises and fails if a promised scenario did not pass (docs/harness-design.md §6):
#
#     HDTP_PREPUSH_LIVE=1 git push          # the PR tier (make harness-pr)
#     HDTP_PREPUSH_LIVE=full git push       # every scenario (make harness-nightly)
#
# This project does not bypass its hooks (CLAUDE.md): a gate that is wrong is fixed, not skipped.
set -euo pipefail

# The tree being gated is the working tree git runs this hook in: the repository's top level,
# which is the node. core.hooksPath is the relative `githooks`, so each worktree runs its own copy.
root="$(git rev-parse --show-toplevel)"
cd "$root"

# The identity module is private and fetched over SSH. GOPRIVATE keeps it off the public proxy
# and checksum database; the insteadOf, set for this process only (never in anybody's git
# config), makes the go command's git fetch it over SSH rather than HTTPS.
export GOPRIVATE="${GOPRIVATE:-github.com/pact-cloud/*}"

# The gate proves the COMMITTED go.mod and go.sum: no go.work the pusher's environment happens to
# resolve (an umbrella's, a GOWORK variable) may stand in for them. The one workspace a gate builds
# is `make dependents`' own, for the cloud's battery (Makefile).
export GOWORK=off
if [ -z "${GIT_CONFIG_COUNT:-}" ]; then
  export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=url.git@github.com:.insteadOf GIT_CONFIG_VALUE_0=https://github.com/
fi

# A push that only deletes refs has nothing to test. The same pass answers whether the push
# touches web/: a new ref, or a base this clone has never fetched, counts as yes.
zero=0000000000000000000000000000000000000000
only_deletes=true
web_touched=false
pushed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  only_deletes=false
  pushed="$pushed $local_sha"
  if [ "$remote_sha" = "$zero" ] || ! git diff --quiet "$remote_sha" "$local_sha" -- web 2>/dev/null; then
    web_touched=true
  fi
done
if [ "$only_deletes" = true ]; then
  exit 0
fi

# What the gate checks is the CHECKED-OUT TREE. Pushing a ref that is not HEAD —
# `git push origin feature:main` — therefore gates the wrong commit. Saying so is honest;
# refusing outright would break a legitimate workflow.
head_sha="$(git rev-parse HEAD)"
for sha in $pushed; do
  [ "$sha" = "$head_sha" ] || echo "pre-push: NOTE — gating the checked-out tree ($(git rev-parse --short HEAD)), not $(git rev-parse --short "$sha")" >&2
done

step() {
  echo "pre-push: make $1"
  if ! make "$1"; then
    echo >&2
    echo "pre-push: make $1 failed. Fix it before pushing: hooks are never bypassed here (CLAUDE.md)." >&2
    exit 1
  fi
}

if [ "$web_touched" = true ]; then
  step web
  if ! git diff --stat --exit-code -- web/dist; then
    echo "pre-push: web/dist is stale — make web changed it. Commit what it wrote." >&2
    exit 1
  fi
fi
# The Postgres engine's tests skip without HDTP_TEST_POSTGRES_DSN, so the hook provides one: a
# NAMED container (the image the node's tests were written against), removed by name on every
# way out of this script. The name carries this hook's PID, so two pushes running at once (two
# worktrees, two builders) never remove each other's database. Without Docker the push is
# refused — a skipped engine is not a pass.
pg="hdtp-gateway-prepush-pg-$$"
if ! docker info >/dev/null 2>&1; then
  echo "pre-push: Docker is not running, and make check needs it for the Postgres engine's tests." >&2
  echo "          Start Docker and push again." >&2
  exit 1
fi
trap 'docker rm -f "$pg" >/dev/null 2>&1 || true' EXIT
docker run -d --name "$pg" -e POSTGRES_USER=hdtp -e POSTGRES_PASSWORD=hdtp \
  -p 127.0.0.1::5432 postgres:16-alpine >/dev/null
for _ in $(seq 1 60); do
  docker exec "$pg" pg_isready -U hdtp -h 127.0.0.1 >/dev/null 2>&1 && break
  sleep 1
done
if ! docker exec "$pg" pg_isready -U hdtp -h 127.0.0.1 >/dev/null 2>&1; then
  echo "pre-push: the Postgres container $pg did not become ready in 60 s" >&2
  exit 1
fi
port="$(docker port "$pg" 5432/tcp | head -1 | sed 's/.*://')"
export HDTP_TEST_POSTGRES_DSN="postgres://hdtp:hdtp@127.0.0.1:${port}/postgres?sslmode=disable"

step check
step analyze
step sqlc-check
step fuzz
step harness

case "${HDTP_PREPUSH_LIVE:-}" in
  "") ;;
  full) step harness-nightly ;;
  *) step harness-pr ;;
esac

# Last: its wall-clock ratios are the gate's one measurement a busy machine can move, so it runs
# when every other step, and the containers they start, have finished.
step scale
