#!/usr/bin/env bash
# Pre-push: run the scenario harness here, because CI cannot.
#
# The harness is a separate module that drives real containers and a real Chrome
# over CDP. A GitHub runner has neither Chrome nor a reason to build the product
# image, so running it there produced failures about the runner rather than
# about the product — every scenario dying with "chrome failed to start". The
# machine that can actually run it is this one.
#
# What runs by default is the hermetic tier (`make harness`): every harness
# package's unit tests against a recorder, the registry and image guards, and
# vet. No Docker. It says the harness compiles and its guards hold; it runs no
# scenario — every live test skips without PACT_HARNESS_LIVE.
#
# The LIVE tiers need Docker and Chrome, so they are opt-in. Each builds what it
# promises and fails if a promised scenario did not pass (docs/harness-design.md §6):
#
#     PACT_PREPUSH_LIVE=1 git push          # the PR tier (make harness-pr)
#     PACT_PREPUSH_LIVE=full git push       # every scenario (make harness-nightly)
#
# This project does not bypass its hooks (CLAUDE.md): a gate that is wrong is fixed, not skipped.
set -euo pipefail

# The tree being pushed is the working tree git runs this hook in, which is not where this file lives:
# core.hooksPath is an absolute path to ONE checkout's githooks/, so from a `git worktree` this file
# is that checkout's copy. Taking the root from the file's own directory gated that other checkout's
# tree on every worktree push (2026-09-27: a worktree's push passed on the main checkout's files, and
# a push from the main checkout failed on a fix that only the worktree carried).
root="$(git rev-parse --show-toplevel)/pact-gateway"
cd "$root"

# A push that only deletes refs has nothing to test.
#
# The same pass over the refs answers a second question: does this push touch `pact-identity/`
# or move the `pact-protocol` pointer? If it does, pact-identity's cross-language gate runs below.
# A new ref has no base to compare with, and a base this clone has never fetched cannot be
# compared at all; both count as "yes", because the gate running once too often costs a minute
# and the gate not running is how it went five days without running anywhere.
zero=0000000000000000000000000000000000000000
only_deletes=true
identity_touched=false
pushed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  only_deletes=false
  pushed="$pushed $local_sha"
  if [ "$remote_sha" = "$zero" ] || ! git diff --quiet "$remote_sha" "$local_sha" -- ../pact-identity ../pact-protocol 2>/dev/null; then
    identity_touched=true
  fi
done
if [ "$only_deletes" = true ]; then
  exit 0
fi

# What the gate below checks is the CHECKED-OUT TREE: `pact-identity/gate.sh` runs cargo, the Go port
# and `js/verify.mjs`, and `verify.mjs`'s answer is about HEAD. Pushing a ref that is not HEAD —
# `git push origin feature:main`, or `HEAD~3:refs/heads/staging` — therefore gates the wrong commit.
# Saying so is honest; refusing outright would break a legitimate workflow.
head_sha="$(git rev-parse HEAD)"
for sha in $pushed; do
  [ "$sha" = "$head_sha" ] || echo "pre-push: NOTE — gating the checked-out tree ($(git rev-parse --short HEAD)), not $(git rev-parse --short "$sha")" >&2
done

echo "pre-push: harness (hermetic) — CI does not run this"
if ! make harness; then
  echo >&2
  echo "pre-push: the harness is broken. Fix it before pushing: hooks are never" >&2
  echo "          bypassed here (CLAUDE.md)." >&2
  exit 1
fi

# pact-identity's gate reads the private sibling `pact-protocol`, which a CI runner cannot see and
# will not be given a credential for (the owner's decision, 2026-09-20). So it runs here or nowhere.
if [ "$identity_touched" = true ]; then
  echo "pre-push: pact-identity gate — CI cannot run this"
  if ! sh ../pact-identity/gate.sh; then
    echo >&2
    echo "pre-push: pact-identity's gate failed (sh pact-identity/gate.sh reproduces it)." >&2
    exit 1
  fi
fi

case "${PACT_PREPUSH_LIVE:-}" in
  "") ;;
  full)
    echo "pre-push: harness nightly tier — needs Docker and Chrome"
    make harness-nightly
    ;;
  *)
    echo "pre-push: harness PR tier — needs Docker and Chrome"
    make harness-pr
    ;;
esac
